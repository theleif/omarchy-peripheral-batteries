{
  "schemaVersion": 1,
  "id": "theleif.accessories",
  "name": "Peripheral Batteries",
  "version": "1.1.0",
  "author": "theleif",
  "description": "Battery levels for connected peripherals over Bluetooth, wireless receivers, USB, and an external JSON source",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Accessories.qml"
  },
  "barWidget": {
    "displayName": "Peripherals",
    "description": "Battery levels for Bluetooth, wireless, USB, and external peripherals",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "showPercent": true,
      "showCount": false,
      "hideWhenEmpty": true,
      "hideWired": false,
      "notifyLow": true,
      "warningThreshold": 30,
      "criticalThreshold": 15,
      "refreshInterval": 10
    },
    "schema": [
      { "key": "showPercent", "type": "boolean", "label": "Show percentage", "default": true },
      { "key": "showCount", "type": "boolean", "label": "Show device count", "default": false },
      { "key": "hideWhenEmpty", "type": "boolean", "label": "Hide when nothing connected", "default": true },
      { "key": "hideWired", "type": "boolean", "label": "Hide wired (USB) devices", "default": false },
      { "key": "notifyLow", "type": "boolean", "label": "Notify on low battery", "default": true },
      { "key": "kdeconnectSource", "type": "boolean", "label": "Read KDE Connect devices", "default": true },
      { "key": "warningThreshold", "type": "number", "label": "Warning threshold (%)", "default": 30 },
      { "key": "criticalThreshold", "type": "number", "label": "Critical threshold (%)", "default": 15 },
      { "key": "refreshInterval", "type": "number", "label": "Refresh interval (seconds)", "default": 10 },
      { "key": "externalPath", "type": "string", "label": "External JSON source path" }
    ]
  }
}
